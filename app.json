{
  "expo": {
    "name": "FocoMais",
    "slug": "focomais",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F5C518"
      },
      "package": "com.wendeldavi.focusflow"
    },
    "platforms": ["android"],
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": ["armeabi-v7a", "arm64-v8a", "x86", "x86_64"],
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "extraProguardRules": "-keep class com.swmansion.reanimated.** { *; }\n-keep class com.facebook.react.turbomodule.** { *; }",
            "gifEnabled": false,
            "webpEnabled": false,
            "webpAnimated": false,
            "networkInspector": true,
            "useLegacyPackaging": false
          }
        }
      ],
      "expo-sqlite",
      "@react-native-community/datetimepicker",
      "expo-font",
      "expo-sharing",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "backgroundColor": "#FAFAF5",
          "imageWidth": 500
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "39f6c4b9-4b5b-42de-aa23-ff7c04057557"
      }
    },
    "jsEngine": "hermes",
    "newArchEnabled": true
  }
}
