{
  "expo": {
    "name": "FocoMais",
    "slug": "focomais",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F5C518"
      },
      "package": "com.wendeldavi.focusflow"
    },
    "platforms": ["android"],
    "plugins": [
      "expo-sqlite",
      "@react-native-community/datetimepicker",
      "expo-font",
      "expo-sharing",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "backgroundColor": "#FAFAF5",
          "imageWidth": 300
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "39f6c4b9-4b5b-42de-aa23-ff7c04057557"
      }
    }
  }
}
